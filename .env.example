# MeshPilot — скопируй в .env и заполни
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GigaChat: https://developers.sber.ru/ (OAuth client_id/secret)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERSIST
# Hermes локально (Ollama) или OpenRouter
HERMES_BASE_URL=http://localhost:11434/v1
HERMES_API_KEY=ollama
HERMES_MODEL=nous-hermes3:8b
# OpenAI-совместимый fallback (OpenRouter, Together, local LM Studio)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Голос по умолчанию: jarvis | khan | anime
MESHPILOT_VOICE=jarvis
MESHPILOT_LANG=ru
MESHPILOT_WAKE_WORD=mesh-pilot
